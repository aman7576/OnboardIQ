{
  "name": "onboardiq-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx src/cli/db-check.ts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "import": "tsx src/cli/import.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:reset": "tsx src/cli/reset.ts",
    "db:process": "tsx src/cli/process.ts",
    "db:seed-users": "tsx src/cli/seed-users.ts",
    "e2e:server": "tsx src/cli/e2e-server.ts",
    "design": "tsx src/cli/design.ts",
    "perf": "tsx src/cli/perf.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "batch": "tsx src/cli/batch.ts",
    "outputs": "tsx src/cli/outputs.ts",
    "outputs:validate": "tsx src/cli/validate-outputs.ts",
    "outputs:repeat": "tsx src/cli/outputs-repeat.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@prisma/client": "~6.19.3",
    "csv-parse": "^6.2.1",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "prisma": "~6.19.3",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^10.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
