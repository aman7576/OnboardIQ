# OnboardIQ environment template. Copy to .env and replace every "change-me" value.
#   cp .env.example .env
# .env is git-ignored. Never commit real secrets. Production refuses to start with "change-me" values.

# development | test | production
NODE_ENV=development
PORT=3000

# --- PostgreSQL (used by docker compose to create the database) ---
POSTGRES_USER=onboardiq
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=onboardiq
POSTGRES_PORT=5432

# API connection string (local dev talks to the compose database on localhost).
DATABASE_URL=postgresql://onboardiq:change-me-db-password@localhost:5432/onboardiq

# --- Secrets (generate with: openssl rand -hex 32) ---
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
CORE_BANKING_SERVICE_KEY=change-me-core-banking-key

# Login sessions last this many minutes (short-lived), then the user must sign in again.
SESSION_TTL_MINUTES=60

# Code the bank gives new KYC / Compliance officers so they can register themselves. Leave empty to turn
# officer sign-up off. Generate with: openssl rand -hex 16
STAFF_ENROLLMENT_CODE=change-me-staff-enrollment-code

# Password for the seeded demo accounts (npm run db:seed). Leave empty to create no demo users.
# Never used when NODE_ENV=production.
SEED_DEMO_PASSWORD=change-me-demo-password

# FR-3: extraction provider, mock | ai
EXTRACTION_PROVIDER=mock

# Optional LLMs (off by default). Provider per feature: none | anthropic | groq.
#   EXTRACTION_LLM     helps the "ai" extraction provider (only the document text is sent; output is re-validated)
#   REVIEW_SUMMARY_LLM writes the AI-5 discrepancy summary on REVIEW cases (only rule results and extracted values)
# EXTRACTION_LLM=groq
# REVIEW_SUMMARY_LLM=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Applicant chatbot IQ: switched on by GROQ_API_KEY alone.
# GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# ANTHROPIC_API_KEY=
# EXTRACTION_LLM_MODEL=claude-haiku-5-5

# Optional: where the importer reads the data pack (read-only) and where outputs are written.
# Defaults: <repo>/csvFiles and <repo>/output
# DATA_DIR=
# OUTPUT_DIR=
