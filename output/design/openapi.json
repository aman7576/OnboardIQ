{
  "openapi": "3.1.0",
  "info": {
    "title": "OnboardIQ API",
    "version": "1.0.0",
    "description": "Savings-account onboarding for Deccan Digital Bank (HCLTech BFSI challenge, use case 02). AI proposes, rules decide, humans approve. Errors are JSON `{ error, message, fields? }`."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque session token from /auth/login"
      },
      "serviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-key"
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness of the API",
        "description": "No authentication.",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/health/db": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Database reachability and latency",
        "description": "No authentication.",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "This document",
        "description": "No authentication.",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register an applicant account (role is always APPLICANT)",
        "description": "No authentication.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80
                  }
                },
                "required": [
                  "email",
                  "password",
                  "display_name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input; `fields` names each bad field"
          },
          "409": {
            "description": "Wrong status, already exists, or someone else changed the case first (optimistic locking)"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in; returns an opaque bearer token (60 minutes)",
        "description": "No authentication.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input; `fields` names each bad field"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "429": {
            "description": "Too many failed logins"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Revoke the current session",
        "description": "Any signed-in user; objects are filtered by ownership/role.",
        "responses": {
          "204": {
            "description": "No content"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "The signed-in user",
        "description": "Any signed-in user; objects are filtered by ownership/role.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          }
        }
      }
    },
    "/api/v1/reference/occupations": {
      "get": {
        "tags": [
          "Reference"
        ],
        "summary": "Occupations for the application form",
        "description": "Any signed-in user; objects are filtered by ownership/role.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          }
        }
      }
    },
    "/api/v1/applications": {
      "post": {
        "tags": [
          "Applications"
        ],
        "summary": "Create an application (FR-2). Aadhaar last 4 digits only; a 12-digit value is refused",
        "description": "Applicant only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "dob": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "M",
                      "F"
                    ]
                  },
                  "pan_number": {
                    "type": "string",
                    "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$"
                  },
                  "aadhaar_last4": {
                    "type": "string"
                  },
                  "mobile": {
                    "type": "string",
                    "pattern": "^[6-9][0-9]{9}$"
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "address": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "state": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "pincode": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{5}$"
                  },
                  "occupation_code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "annual_income": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000000000
                  },
                  "consent_kyc": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "full_name",
                  "dob",
                  "gender",
                  "pan_number",
                  "aadhaar_last4",
                  "mobile",
                  "email",
                  "address",
                  "city",
                  "state",
                  "pincode",
                  "occupation_code",
                  "annual_income",
                  "consent_kyc"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input; `fields` names each bad field"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "403": {
            "description": "Role not allowed (or maker = checker)"
          }
        }
      }
    },
    "/api/v1/applications/mine": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "The caller's own applications",
        "description": "Applicant only.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "403": {
            "description": "Role not allowed (or maker = checker)"
          }
        }
      }
    },
    "/api/v1/applications/{applicationId}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Application detail. Applicant: own case, plain-language reasons and timeline. Staff: extracted fields with confidence, rule trace, screening (decision response of spec 6.3)",
        "description": "Any signed-in user; objects are filtered by ownership/role.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "404": {
            "description": "Not found, or not yours (no data is revealed)"
          }
        }
      }
    },
    "/api/v1/applications/{applicationId}/documents": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Document list (no text)",
        "description": "Any signed-in user; objects are filtered by ownership/role.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "404": {
            "description": "Not found, or not yours (no data is revealed)"
          }
        }
      },
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Upload .txt documents (UTF-8, at most 1 MB each, at least 3 on first submission, one declared_doc_type per file). Same file again is not duplicated (SHA-256)",
        "description": "Applicant only.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "files",
                  "declared_doc_type"
                ],
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "declared_doc_type": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "PAN_CARD",
                        "AADHAAR_CARD",
                        "ELECTRICITY_BILL",
                        "BANK_STATEMENT",
                        "DRIVING_LICENCE"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input; `fields` names each bad field"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "403": {
            "description": "Role not allowed (or maker = checker)"
          },
          "404": {
            "description": "Not found, or not yours (no data is revealed)"
          },
          "409": {
            "description": "Wrong status, already exists, or someone else changed the case first (optimistic locking)"
          },
          "422": {
            "description": "File or business validation failed"
          }
        }
      }
    },
    "/api/v1/applications/{applicationId}/documents/{docId}": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Document text; every view is audited (FR-9)",
        "description": "Any signed-in user; objects are filtered by ownership/role.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "404": {
            "description": "Not found, or not yours (no data is revealed)"
          }
        }
      }
    },
    "/api/v1/applications/{applicationId}/submit": {
      "post": {
        "tags": [
