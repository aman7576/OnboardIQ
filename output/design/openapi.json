    "/api/v1/applications/{applicationId}/resubmit": {
      "post": {
        "tags": [
          "Workflow"
        ],
        "summary": "Resubmit after RESUBMISSION_REQUESTED (within the window); evaluated again",
        "description": "Applicant only.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "403": {
            "description": "Role not allowed (or maker = checker)"
          },
          "404": {
            "description": "Not found, or not yours (no data is revealed)"
          },
          "409": {
            "description": "Wrong status, already exists, or someone else changed the case first (optimistic locking)"
          },
          "422": {
            "description": "File or business validation failed"
          }
        }
      }
    },
    "/api/v1/applications/{applicationId}/corrections": {
      "post": {
        "tags": [
          "Workflow"
        ],
        "summary": "Correct extracted fields, each with a reason (confidence 1.00, source OFFICER); rules re-run; case goes to the checker",
        "description": "KYC Officer only.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "corrections": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "doc_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "field_name": {
                          "type": "string",
                          "enum": [
                            "doc_type",
                            "name",
                            "dob",
                            "gender",
                            "pan_number",
                            "aadhaar_last4",
                            "address",
                            "pincode",
                            "document_date",
                            "valid_until"
                          ]
                        },
                        "new_value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        }
                      },
                      "required": [
                        "doc_id",
                        "field_name",
                        "new_value",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "corrections"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input; `fields` names each bad field"
          },
          "401": {
            "description": "Not signed in, or invalid service key"
          },
          "403": {
            "description": "Role not allowed (or maker = checker)"
          },
          "404": {
            "description": "Not found, or not yours (no data is revealed)"
          },
          "409": {
            "description": "Wrong status, already exists, or someone else changed the case first (optimistic locking)"
          }
        }
      }
    },
